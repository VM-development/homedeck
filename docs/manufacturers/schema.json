{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VM-development/homedeck/main/docs/manufacturers/schema.json",
  "title": "Open Local Control (OLC) 0.1",
  "description": "How to talk to one device model over Bluetooth or the home network, and how well it keeps strangers out. See format.md.",
  "type": "object",
  "required": ["olc", "device", "links", "security", "messages"],
  "additionalProperties": false,
  "properties": {
    "olc": { "const": "0.1" },
    "note": { "type": "string" },
    "device": {
      "type": "object",
      "required": ["maker", "model", "firmware", "category"],
      "additionalProperties": false,
      "properties": {
        "maker": { "type": "string" },
        "model": { "type": "string" },
        "firmware": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "manual": { "type": "string", "format": "uri" }
      }
    },
    "links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } },
    "security": { "$ref": "#/$defs/security" },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/message" }
    },
    "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
    "uuid": { "type": "string", "pattern": "^([0-9A-Fa-f]{4}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$" },
    "link": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["ble", "http", "https", "websocket", "coap", "coaps", "udp", "tcp"] },
        "advertises": { "$ref": "#/$defs/uuid" },
        "connections": { "type": "integer", "minimum": 1 },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uuid", "characteristics"],
            "additionalProperties": false,
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "use": { "type": "string" },
              "characteristics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["uuid", "properties"],
                  "additionalProperties": false,
                  "properties": {
                    "uuid": { "$ref": "#/$defs/uuid" },
                    "properties": {
                      "type": "array",
                      "items": { "enum": ["read", "write", "write-without-response", "notify", "indicate"] }
                    }
                  }
                }
              }
            }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "discovery": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "bonjour": { "type": "string" },
              "multicast": { "type": "string" },
              "broadcast": { "type": "integer" },
              "probe": { "type": "string" },
              "manual": { "type": "string" }
            }
          }
        },
        "certificate": { "enum": ["ca", "self-signed", "pinned-at-pairing"] },
        "note": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "ble" } } },
      "then": { "required": ["advertises", "services"] },
      "else": { "required": ["port"] }
    },
    "security": {
      "type": "object",
      "required": ["level", "key", "pairing", "setupCode", "encryption", "integrity", "freshness",
                   "controllers", "worksOffline", "buttonPressFor", "otherInterfaces", "disclosure"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["open", "shared-secret", "per-device-key", "owner-key"] },
        "key": {
          "type": "object",
          "required": ["unique", "from"],
          "additionalProperties": false,
          "properties": {
            "unique": { "enum": ["none", "per-model", "per-device"] },
            "from": { "enum": ["none", "app", "vendor-cloud", "device", "pairing"] }
          }
        },
        "pairing": { "enum": ["none", "ble-just-works", "ble-passkey", "ble-numeric-comparison", "ble-oob",
                              "setup-code-pake", "shared-secret", "vendor-account"] },
        "setupCode": { "enum": ["none", "label", "display", "box"] },
        "encryption": { "enum": ["none", "tls", "ble-link-layer", "aes-cbc", "aes-ccm", "aes-gcm", "chacha20-poly1305"] },
        "integrity": { "enum": ["none", "unkeyed-hash", "keyed-hash", "aead"] },
        "freshness": { "enum": ["none", "unauthenticated-counter", "counter", "nonce", "tls"] },
        "controllers": { "enum": ["anyone", "one", "many", "many-revocable"] },
        "worksOffline": { "type": "boolean" },
        "buttonPressFor": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "otherInterfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["what", "protection"],
            "additionalProperties": false,
            "properties": {
              "what": { "type": "string" },
              "protection": { "enum": ["none", "unknown", "same", "signed-firmware"] }
            }
          }
        },
        "disclosure": {
          "type": "object",
          "required": ["contact", "supportUntil"],
          "additionalProperties": false,
          "properties": {
            "contact": { "type": ["string", "null"], "format": "uri" },
            "supportUntil": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" }
          }
        },
        "envelope": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "required": ["link", "to"],
      "additionalProperties": false,
      "properties": {
        "link": { "$ref": "#/$defs/id" },
        "to": { "enum": ["device", "app"] },
        "characteristic": { "$ref": "#/$defs/uuid" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
        "path": { "type": "string" },
        "observe": { "type": "boolean" },
        "reply": { "$ref": "#/$defs/id" },
        "encrypted": { "type": "boolean" },
        "bytes": { "type": "string" },
        "json": { "type": "object" },
        "fields": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(/[^/]*)*$" } },
        "text": { "type": "string" },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fields"],
            "additionalProperties": false,
            "properties": {
              "bytes": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}( [0-9A-Fa-f]{2})*$" },
              "json": { "type": "object" },
              "fields": { "type": "object" },
              "note": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      },
      "not": { "anyOf": [
        { "required": ["bytes", "json"] }, { "required": ["bytes", "text"] }, { "required": ["json", "text"] }
      ] },
      "dependentRequired": { "fields": ["json"] }
    },
    "property": {
      "type": "object",
      "required": ["id", "title", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "type": { "enum": ["number", "integer", "boolean", "string", "enum"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["wire", "means"],
            "additionalProperties": false,
            "properties": { "wire": {}, "means": { "type": "string" } }
          }
        },
        "unit": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "read": { "$ref": "#/$defs/id" },
        "write": { "$ref": "#/$defs/id" },
        "note": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "enum" } } },
      "then": { "required": ["values"] }
    },
    "action": {
      "type": "object",
      "required": ["id", "title", "send", "risky"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "send": { "$ref": "#/$defs/id" },
        "risky": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
